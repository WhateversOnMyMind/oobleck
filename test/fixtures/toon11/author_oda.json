{"status":"success","list":[{"wr_id":"20947","wr_subject":"\ub2e4\uc774\uc1fc \ub85c\ub9e8\ud2f0\uce74","ca_name":"\uc21c\uc815","wr_content":"\ub54c\ub294 \uac00\uc0c1\uc758 \ub2e4\uc774\uc1fc \uc2dc\ub300. \uc544\ubc84\uc9c0\uc758 \uc720\ud488\uc744 \ub3cc\ub824\ubc1b\uae30 \uc704\ud574 \uacf5\uc791\uc758 \uc800\ud0dd\uc5d0 \ub098\ud0c0\ub09c \uba54\uc774. \uadf8\ub7f0 \uadf8\ub140\ub97c \ub9de\uc774\ud55c \uac74, \uae08\ubc1c\uc5d0 \ud478\ub978 \ub208\ub3d9\uc790\ub97c \uac00\uc9c4 \ub2e4\ub978 \ub098\ub77c\uc758 \uacf5\uc791\ub2d8! \uba54\uc774\ub294 \uc720\ud488\uc744 \ub3cc\ub824\ubc1b\uae30 \uc704\ud574\uc11c \uacf5\uc791\uc774 \uc564\ud2f0\ud06c \ubb34\uc5ed \uc77c\ub85c \uc77c\ubcf8\uc5d0 \uc788\ub294 \ub3d9\uc548 \uadf8\uc758 \uc2e0\ubd80 \uc5ed\ud560\uc744 \ub9e1\uac8c \ub418\ub294\ub370\u2026?! \ud55c\uc2dc\uc801 \uc2e0\ubd80\uc758 \uc564\ud2f0\ud06c \ub85c\ub9e8\uc2a4\u2665","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2024-01-12 14:15:54","wr_2":"5","numone":"170537"},{"wr_id":"20948","wr_subject":"\uccab\uc0ac\ub791 \ub354\ube14 \uc5d0\uc9c0","ca_name":"\uc21c\uc815","wr_content":"\u300c\ub2e4\uc774\uc1fc \ub85c\ub9e8\ud2f0\uce74\u300d \uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0\uc758 \uc0ac\ub791\uc2a4\ub7f0 \uc2e0\uc791!  \ub0a8\uc790\ub294 \ub291\ub300! \uc5ec\uc790\ub294 \ud558\ub098\uac19\uc774 \ud55c\ub07c \uc2dd\uc0ac\ubc16\uc5d0 \uc548 \ub418\ub294 \uc6b4\uba85. \ud558\uc9c0\ub9cc \uc5b4\ucc28\ud53c \uafc0\uaebd\ub420 \uac70\ub77c\uba74 \uba4b\uc788\ub294 \ub291\ub300\ud55c\ud14c \ub2f9\ud558\uace0 \uc2f6\uc740 \uac8c \uc778\uc9c0\uc0c1\uc815! \u2026\u2026\uc774 \uc9c0\ub860\uc778 \uc5ec\uace0\uc0dd \uc694\uc6b0. \uadf8\ub7f0 \uc694\uc6b0 \uc55e\uc5d0 \uc644\ubcbd\ud55c \uc774\uc0c1\ud615, \uaf43\ubbf8\ub0a8 \uc0ac\ud68c\uc778 \uae30\ud0c0\ub9ac\uc2a4\ud2b8 \ud1a0\ub178\ub2e4\uac00 \ub098\ud0c0\ub09c\ub2e4. \uc694\uc6b0\ub294 \uadf8\ub97c \ub9cc\ub098\uc790\ub9c8\uc790 \ubc14\ub85c \uc0ac\ub791\uc5d0 \ube60\uc838\ubc84\ub9ac\ub294\ub370\u2026?!  \ucf54\uc774 \uc2dc\ub9ac\uc988 \uc81c10\ud0c4! \uba4b\uc7c1\uc774 \uae30\ud0c0\ub9ac\uc2a4\ud2b8\uc640 \ub0a8\uc131\uacf5\ud3ec\uc99d \uc5ec\uace0\uc0dd\uc758 \uc54c\ucf69\ub2ec\ucf69 \ubd80\ub7ec\uc6c0 \ubc31\ubc30 \uc5f0\uc560 \uc774\uc57c\uae30!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2019-10-28 17:13:31","wr_2":"14","numone":"171340"},{"wr_id":"20949","wr_subject":"\uc5f0\uc0c1\uc758 \uc0ac\ub78c","ca_name":"\uc21c\uc815","wr_content":"\uc88b\uc544\ud558\uac8c \ub41c \uac83\uc740 \uc5f0\uc0c1\uc758 \uc0c1\uc0ac.\uc815\uc2e0\uc744 \ucc28\ub9ac\ub2c8 \ub098\uc774\ub3c4 \ud68c\uc0ac\uc758 \uc0c1\uc0ac\uc778 \uac83\ub3c4 \ubaa8\uc870\ub9ac \uc78a\uc744 \ub9cc\ud07c \uc88b\uc544\ud558\uac8c \ub418\uc5c8\ub2e4.\uc0ac\ub78c\uc744 \uc88b\uc544\ud558\uac8c \ub418\ub294 \uc560\uc808\ud568\ub3c4 \uae30\uc068\ub3c4 \uc804\ubd80 \ub2f9\uc2e0\uc774 \uac00\ub974\uccd0\uc8fc\uc5c8\ub2e4.\uc5b4\ub290 \uc0c8 \uac00\uc2b4\uc774 \ucc21\ud574\uc9c0\ub294 \ube44\ubc00\uc758 \uc624\ud53c\uc2a4 \ub7ec\ube0c!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2019-10-28 17:13:31","wr_2":"14","numone":"171268"},{"wr_id":"20950","wr_subject":"\ub204\ub4dc\ub294 \uc0ac\ub791\uc744 \uac78\uce5c\ub2e4","ca_name":"\uc21c\uc815","wr_content":"\ub2f9\uc2e0\uc774 \ub0b4 \uc138\uacc4\ub97c \uc804\ubd80 \ub4a4\ubc14\uafe8\ub2e4.\ubbf8\ub300\uc0dd \ucf54\uc6b0\uac00 \uc544\ub974\ubc14\uc774\ud2b8\ub97c \ud558\ub294 \uc544\ud2c0\ub9ac\uc5d0\uc5d0\uc11c \ub9cc\ub09c \uac74 \uc544\ud2b8\ubaa8\ub378 \ub098\ub098\ubbf8.\ub098\ub098\ubbf8\uac00 \uc544\ud2b8\ubaa8\ub378\uc744 \ud558\ub294 \uc774\uc720\ub294\u2026?!\uc2e0\uc791 \ubc88\uc678\ud3b8\ub3c4 \uc218\ub85d!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2021-02-03 15:11:20","wr_2":"14","numone":"170676"},{"wr_id":"20951","wr_subject":"Honey Honey ~\ud5c8\ub2c8\ud5c8\ub2c8~","ca_name":"\uc21c\uc815","wr_content":"\uc5b4\ub290 \uc0ac\uc815\uc73c\ub85c \uae61\ucd0c\uc5d0\uc11c \uc804\ud559 \uc628 \ud558\ub2c8\ud558\ub098 \uc720\uc6b0\ud55c\ud14c\ub294?! \uc2e0\uc138\ub300 \ub0a8\ud559\uc0dd, \uc21c\uc815\ud30c \uc2dc\uace8\uc18c\ub140. \uc560\uc808\ud568\uacfc \ubb49\ud074\ud568\uc774 \uac00\ub4dd\ud55c \uc6b4\uba85\uacfc \uaca9\ucc28\uc758 \ub7ec\ube0c \uc2a4\ud1a0\ub9ac!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2021-02-04 01:21:22","wr_2":"14","numone":"170625"},{"wr_id":"20952","wr_subject":"\ub3d9\uac70 \uc774\uc0c1 \ub3d9\uc11c \ubbf8\ub9cc","ca_name":"\uc21c\uc815","wr_content":"\ub9de\ub2ff\uc740 \ub4f1 \ub108\uba38\ub85c \uc774 \ub9c8\uc74c\ub3c4 \uc804\ud574\uc9c0\uba74 \uc88b\uc744 \ud150\ub370\u2026.\uc88b\uc544\ud588\ub358 \ub0a8\uc790\uc544\uc774\uc640 \uc6b0\uc5f0\ud788 \uc7ac\ud68c\ud55c \ub9b0.\uadfc\ub370 \uadf8\uac74 `\uac00\uc871`\uc774\ub77c\ub294 \ud615\ud0dc\ub85c\u2026?!\uc54c\uba74 \uc54c\uc218\ub85d `\uc88b\uc544\ud558\uac8c` \ub41c\ub2e4.\ud558\uc9c0\ub9cc\u2015\uc560\uc808\ud558\uace0 \uc124\ub818 \uac00\ub4dd\ud55c \uadfc\uac70\ub9ac \uc5f0\uc560!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"04","wr_datetime":"2019-10-28 17:13:31","wr_2":"14","numone":"171241"},{"wr_id":"25698","wr_subject":"\uaf43\uc740 \uc5b4\ub290 \ucabd?","ca_name":"\uc21c\uc815","wr_content":"\ud0a4\uc2a4\uae30 \ud558\ub098\ub294 \uc77c \ubcf5\ub3c4 \ub0a8\uc790 \ubcf5\ub3c4 \uc5c6\uc774 \ubb34\uae30\ub825\ud558\uac8c \uc0ac\ub294 28\uc138 \ud68c\uc0ac\uc6d0. \uc5b4\ub290 \ub0a0 \uacc4\ub2e8\uc5d0\uc11c \ubc1c\uc744 \uc798\ubabb \ub514\ub514\uace0 \ub208\uc744 \ub5a0\ubcf4\ub2c8 17\uc0b4 \uc5ec\uace0\uc0dd \uc57c\ub9c8\ub2e4 \ud558\ub098\uc758 \ubaa8\uc2b5\uc774 \ub418\uc5b4\uc788\uc5c8\ub2e4! \uc5b4\uca54 \uc218 \uc5c6\uc774 \uc57c\ub9c8\ub2e4 \ud558\ub098\uac00 \ud558\uc219\ud558\ub294 \u2018\uc774\ucfe0\ud0c0\uc7a5\u2019\uc5d0\uc11c \uc0ac\ud68c\uc778\uc778 \ud558\ub8e8\ud0a4, \uace0\ub4f1\ud559\uc0dd\uc778 \ud558\ub8e8\uce58\uce74\uc640 \ud568\uaed8 \uc5ec\uace0\uc0dd \ud558\ub098\ub85c \uc0dd\ud65c\ud558\uac8c \ub418\ub294\ub370\u2026. \ub0a8\uc790\uc5d0\uac8c \uc124\ub810 \ubed4\ud558\uba74\uc11c\ub3c4 \ub2e4\ub978 \uc0ac\ub78c\uc758 \ubab8\uc73c\ub85c \uc0ac\ub791\uc744 \ud558\uba74 \uc548 \ub41c\ub2e4\uba70 \uace0\ubbfc\ud558\uae30\ub3c4 \ud558\uace0 \ubc18\ub300\ub85c \u2018\uc88b\uc544\ud55c\ub2e4\u2019\ub294 \uace0\ubc31\uc744 \ub4e3\uae30\ub3c4 \ud55c\ub2e4. \ud558\ub098\ub294 \ub2e4\uc2dc \uc6d0\ub798 \ubaa8\uc2b5\uc73c\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\uc744\uae4c?","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"06","wr_datetime":"2022-10-12 16:51:54","wr_2":"4","numone":"305657"},{"wr_id":"23561","wr_subject":"\uadf8\uc758 \uccab \ubc88\uc9f8\uac00 \ub418\ub294 \ubc29\ubc95","ca_name":"\uc21c\uc815","wr_content":"`\ud2b9\ubcc4`\ud55c \uc0ac\ub78c\uc774 \uc5c6\ub294 \ub108\uc5d0\uac8c `\ud2b9\ubcc4`\ud574\uc9c0\uace0 \uc2f6\ub2e4.\uac11\uc791\uc2a4\ub7f0 \uc804\ud559. \uadf8\uacf3\uc5d0\uc11c \ub9cc\ub09c, \uc624\ub294 \uc0ac\ub78c \uc548 \ub9c9\uace0 \uac00\ub294 \uc0ac\ub78c \uc548 \ub9d0\ub9b0\ub2e4\ub294 \uc778\uae30\ub0a8 \ubbf8\uc57c\ub97c \uc88b\uc544\ud558\uac8c \ub41c \ub098. \uc2a4\ud0ac \ucc28\uac00 \ub108\ubb34 \ub098\ub294 \ub0b4\uac00 \uacfc\uc5f0 \ubbf8\uc57c\uc758 \ub9c8\uc74c\uc744 \uc190\uc5d0 \ub123\uc744 \uc218 \uc788\uc744\uae4c\u2026?","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"05","wr_datetime":"2020-04-15 11:20:12","wr_2":"14","numone":"226605"},{"wr_id":"34518","wr_subject":"\uac70\uc9d3\ub9d0\uc744 \uac04\ud30c\ud558\ub294 \uc704\uc7a5 \uc655\ub140","ca_name":"\ub4dc\ub77c\ub9c8,\uc21c\uc815","wr_content":"\uac70\uc9d3\uacfc \ubaa8\ub7b5\uc774 \ud310\uce58\ub294 \uad81\uc815 \ub85c\ub9e8\uc2a4, \uc81c1\uad8c!\ub958\ud050 \uc655\uad6d\uc758 \uc655\uc5d0\uac8c\uc77c\uc871\uc744 \ubab0\uc0b4\ub2f9\ud55c \uc18c\ub140, \uc624\ud1a0\ub294 \ubcf5\uc218\ub97c \uc704\ud574 \uc655\ub140 \uc554\uc0b4\uc744 \uaf80\ud55c\ub2e4.\ud558\uc9c0\ub9cc \uac70\uc9d3\ub9d0\uc744 \uaff0\ub6ab\uc5b4 \ubcf4\ub294\uc2e0\ube44\ud55c \ud798\uc744 \uac00\uc9c4 \uc624\ud1a0\uac00\uc228\ud1b5\uc744 \ub04a\uc73c\ub824\uace0 \ud588\ub358 \uc0ac\ub78c\uc740\u201c\uc655\ub140\uc758 \ub300\uc5ed(\uc131\ubcc4: \ub0a8\uc790)\u201d\uc774\uc5c8\ub294\ub370\u2026\u2026?!","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"07","wr_datetime":"2026-01-04 11:08:46","wr_2":"6","numone":"1731886"},{"wr_id":"33481","wr_subject":"\ud038(Queen)","ca_name":"\uc21c\uc815","wr_content":"\uc2e0\ubd84\uc744 \uc228\uae30\uace0 \uc0ac\ub294 \ubc84\ub9bc\ubc1b\uc740 \uacf5\uc8fc\uc758 \uc18c\ub9dd\uc740 \uc0ac\ub78c\ub4e4\uc758 \ub208\uc5d0 \ub744\uc9c0 \uc54a\uace0 \ucc9c\uba85\uc744 \ub2e4\ud558\ub294 \uac83.\ud558\uc9c0\ub9cc \uc5b4\ub5a4 \ub0a8\uc131\uc744 \ub9cc\ub098\uac8c \ub418\uba74\uc11c \uc0c8\ub85c\uc6b4 \uc6b4\uba85\uc758 \ud1b1\ub098\ubc14\ud034\uac00 \uad74\ub7ec\uac00\uae30 \uc2dc\uc791\ud558\ub294\ub370\u2026.","wr_6":"\uc624\ub2e4\uc640\ub77c \ubbf8\uc988\uc5d0","wr_3":"07","wr_datetime":"2023-06-09 15:03:03","wr_2":"4","numone":"1681211"},{"wr_id":"11489","wr_subject":"\ub7ec\ube0c\ub77c\uc774\ube0c! \uc120\uc0e4\uc778!!","ca_name":"\ud559\uc6d0,\ub4dc\ub77c\ub9c8","wr_content":"\uc8fc\uc778\uacf5\uc778 \ud0c0\uce74\ubbf8 \uce58\uce74\ub294 \u03bc\u2019s\ub97c \ub3d9\uacbd\ud574\uc11c, \uc2a4\ucfe8 \uc544\uc774\ub3cc\uc744 \ubaa9\ud45c\ud558\uac8c \ub41c \uace02 \uc5ec\ud559\uc0dd. \uadf8\ub140\uac00 \uc0ac\ub294 \uacf3\uc740 \uc2dc\uc988\uc624\uce74\ud604 \ub204\ub9c8\uc988\uc2dc\uc758 \uc2dc\uace8 \uc5b4\ucd0c\uc778 \uc6b0\uce58\uc6b0\ub77c[5]\ub77c\ub294 \ud574\ubcc0 \ub9c8\uc744. \uacf6 \ub044\ud2b8\uba38\ub9ac\uc5d0 \uc788\ub294 \uade4\ubc2d\uc73c\ub85c \ub458\ub7ec\uc2f8\uc778 \uc804\uad50\uc0dd 100\uba85\ub3c4 \uc548 \ub418\ub294 \uc6b0\ub77c\ub178\ud638\uc2dc \uc5ec\ud559\uc6d0\uc774\ub77c\ub294 \uc791\uc740 \ud559\uad50\ub97c \ubd80\ud765\uc2dc\ud0a4\uae30 \uc704\ud574, \uc544\ud649 \uba85\uc758 \uc18c\ub140\ub4e4\uc740 \uc2a4\ucfe8 \uc544\uc774\ub3cc\uc774 \ub420 \uacb0\uc758\ub97c \ud55c\ub2e4.  \uc5ec\uae30\ub3c4 \uc624\ud1a0\ub178\ud0a4\uc790\uce74 \ud559\uc6d0\uacfc \ub9c8\ucc2c\uac00\uc9c0\ub85c \ud3d0\uad50\ub97c \ub208 \uc55e\uc5d0 \ub450\uace0 \uc788\ub294 \uc0c1\ud669. \uc624\ud1a0\ub178\ud0a4\uc790\uce74\ub294 \ud3d0\uad50 \uc9c1\uc804\uc5d0 \uae30\uc0ac\ud68c\uc0dd\ud588\uc9c0\ub9cc, \uc774\ubc88 \uc791\uc758 \ubc30\uacbd\uc774 \ub418\ub294 \uc774 \ud559\uad50\ub294 \ud3d0\uad50\uac00 \ud655\uc815\ub418\uc5b4 \uc788\ub2e4\ub294 \uc810\uc774 \ub2e4\ub974\ub2e4. \uc560\ub2c8\uba54\uc774\uc158 \uae30\uc900\uc73c\ub860 1\uae30 \ub54c \ud3d0\uad50 \uacb0\uc815 \uc5ec\ubd80\uc5d0\uc11c \ub05d\ub0ac\uc73c\ub098, 2\uae30 \uc2dc\uc791\ubd80\ud130 \uc124\uba85\ud68c \uc911\ub2e8\uc73c\ub85c \ud3d0\uad50\uac00 \ud655\uc815\ub418\uc5c8\ub2e4.","wr_6":"\uc624\ub2e4 \ub9c8\uc0ac\ub8e8","wr_3":"11","wr_datetime":"2019-03-14 18:32:01","wr_2":"14","numone":"118943"},{"wr_id":"34758","wr_subject":"\uc81c7\uc655\uc790\ub85c \ud0dc\uc5b4\ub0ac\ub294\ub370 \ubb58 \ud574\uc57c \ub418\uc9c0?","ca_name":"\ub77c\ub178\ubca8,\uc774\uc138\uacc4,\uc804\uc0dd,\ud310\ud0c0\uc9c0","wr_content":"\ud0dc\uc5b4\ub09c \uadf8 \uc21c\uac04,\uc804\uc0dd\uc758 \uae30\uc5b5\uc744 \uac16\uace0 \uc788\ub2e4\ub294 \uc0ac\uc2e4\uc744 \uae68\ub2ec\uc740\uccb8\ud2b8\ub85c \uc655\uad6d\uc758 \uc655\uc790 \ub77c\uc774\ubaac\ub4dc.\ubd80\ubaa8\ub294 \ubb3c\ub860\uc774\uace0, \uc218\ubc1c \ub2f4\ub2f9\uc778 \ub9c8\ub9ac\uc544,\uac80\uc220 \uc9c0\ub3c4\uc790 \ud050\ub9ac\ub85c\uc2a4\uc758 \uc560\uc815\ub3c4 \ub4ec\ubfcd \ubc1b\uc73c\uba70\uc0c8\ub85c\uc6b4 \uc0dd\ud65c\uc744 \uc2dc\uc791\ud55c \uadf8\ub294 \uc790\uc2e0\uc774 7\ubc88\uc9f8 \uc655\uc790,\uc989 6\uba85\uc758 \ud615\uc774 \uc788\ub2e4\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub41c\ub2e4.\uc2ec\uc9c0\uc5b4 \ud558\ub098\uac19\uc774 \ub2e4 \ub300\ub2e8\ud55c \uc0ac\ub78c\ub4e4.\uc5c4\ub9c8\ub294 \uadf8\uac00 \ucc28\uae30 \uad6d\uc655\uc774 \ub418\uae38 \uc6d0\ud558\uace0 \uc788\uc73c\ub098,\uc194\uc9c1\ud788 \ud615\ub4e4\uacfc \uc2f8\uc6c0 \ub530\uc708 \ud558\uace0 \uc2f6\uc9c0 \uc54a\ub2e4.\u3161\uadf8\ub807\ub2e4\uba74 \ub098\ub294 \uc774 \uc138\uacc4\uc5d0\uc11c \ubb58 \ud574\uc57c \ub420\uae4c?\ub9c9\ub0b4 \uc655\uc790 \ub77c\uc774\ubaac\ub4dc\uc758 \uc774\uc138\uacc4 \ud310\ud0c0\uc9c0 \ub77c\uc774\ud504 \uac1c\ub9c9!I","wr_6":"\uc624\ub2e4\uc57c\uce74","wr_3":"07","wr_datetime":"2025-04-22 17:32:58","wr_2":"4","numone":"1744443"},{"wr_id":"34130","wr_subject":"\uacb0\uacc4\uc0ac\uc758 \uc77c\ub95c\ud654","ca_name":"\ub77c\ub178\ubca8,\ud310\ud0c0\uc9c0","wr_content":"","wr_6":"\uc624\ub2e4\uc57c\uce74","wr_3":"07","wr_datetime":"2024-01-31 12:42:32","wr_2":"14","numone":"1712799"},{"wr_id":"10888","wr_subject":"\uc6d0\ud2f0\ub4dc(WANTED)","ca_name":"\uc21c\uc815, \ud310\ud0c0\uc9c0","wr_content":"\uc6d0\ud53c\uc2a4\uc758 \uc791\uac00, \uc624\ub2e4 \uc5d0\uc774\uc774\uce58\ub85c\uc758 \ucd08\uae30 \ub2e8\ud3b8\uc9d1.","wr_6":"\uc624\ub2e4 \uc5d0\uc774\uce58\ub85c","wr_3":"11","wr_datetime":"2019-03-14 18:29:04","wr_2":"14","numone":"109483"},{"wr_id":"2","wr_subject":"\uc6d0\ud53c\uc2a4(ONE PIECE)","ca_name":"\uc560\ub2c8\ud654,\uc561\uc158,\ud310\ud0c0\uc9c0","wr_content":"\ud45c\uba74 \ub300\ubd80\ubd84\uc774 \ubc14\ub2e4\uc778 \ud589\uc131\uc744 \ubc30\uacbd\uc73c\ub85c \ud558\uc5ec \ub300\ube44\ubcf4 \uc6d0\ud53c\uc2a4\ub97c \ub450\uace0 \ub300\ud574\uc801 \uc2dc\ub300\uac00 \uc5f4\ub9b0 \ud6c4 \uc8fc\uc778\uacf5 \ubabd\ud0a4 D. \ub8e8\ud53c\uc640 \uadf8\uc758 \ub3d9\ub8cc\ub4e4\uc774 \ud574\uc801\ub2e8\uc744 \uacb0\uc131\ud558\uc5ec \ubc14\ub2e4\ub97c \ud56d\ud574\ud558\uace0 \uc5ec\ub7ec \uc12c\ub4e4\uc744 \uc5ec\ud589\ud558\ub294 \ubaa8\ud5d8\uae30\ub97c \ub2e4\ub8ec\ub2e4.","wr_6":"\uc624\ub2e4 \uc5d0\uc774\uc774\uce58\ub85c","wr_3":"03","wr_datetime":"2026-11-23 16:50:04","wr_2":"2","numone":"273"},{"wr_id":"25330","wr_subject":"\u00b1\uc774\uc628","ca_name":"TS,\uc561\uc158","wr_content":"","wr_6":"\uc624\ub2e4 \uc138\ub9ac\ub098","wr_3":"06","wr_datetime":"2020-12-09 16:24:40","wr_2":"12","numone":"295283"},{"wr_id":"8116","wr_subject":"\uc544\uce74\uc774 \uc528\ub294 \uc624\ub298\ub3c4 \ub9c9\ud600\uc788\uc5b4","ca_name":"\uac1c\uadf8, \ub7ec\ube0c\ucf54\ubbf8\ub514","wr_content":"\uc544\uce74\uc774 \ucf54\ub9c8 \uace0\ub4f1\ud559\uad50 1\ud559\ub144. \ud604\uc7ac \uc7a5\ub824\ud68c 1\uae09. \u300c\ud504\ub85c \uae30\uc0ac\u300d\ub97c \uafc8\uafb8\uba70 \uc7a5\uae30\uc5d0 \ubaa8\ub4e0 \uac83\uc744 \uac74 \uadf8\ub140\ub294 \ub9d0\ud55c\ub2e4.\u2015\u300e\uc7a5\uae30 \uc774\uc678\uc758 \uac83\uc5d0 \ud55c\ub208\ud30c\ub294 \uac74 \ub0ad\ube44\ub77c\uace0 \uc0dd\uac01\ud574.\u300f??!!\ud559\ucc3d \uc2dc\uc808\uc740 \uc774\ubbf8 \ub9dd\ud55c \ub08c\uc0c8&\uc624\ub298\ub3c4 \ud0c0\ub2e4\ub178 \uc120\uc0dd\ub2d8\uc744 \ub180\ub9ac\ub290\ub77c \ubc14\uc058\ub2e4\u2606\ud788\ud0a4\ucf54\ubaa8\ub9ac\uacc4(?) \uc7a5\uae30 \uc774\uc678\uc5d0\ub294 \ubaa8\ub4e0 \uac8c \uc5b4\uc124\ud508 \uadf8\ub140\uc758 \uadc0\uc5ec\uc6b4 \uc77c\uc0c1.\ubb34\uc5c7 \ud558\ub098 \uc27d\uc9c0 \uc54a\uc740, \uadf8\ub140\uc758 \uc77c\uc0c1 4\ucef7 \ub9cc\ud654 \uc81c1\uad8c\uc785\ub2c8\ub2e4\u2606","wr_6":"\uc624\ub2e4\uce74 \uc900\uc774\uce58","wr_3":"11","wr_datetime":"2019-03-14 18:29:04","wr_2":"14","numone":"62761"},{"wr_id":"33869","wr_subject":"\uc804\uc0dd\ud669\uc790\uac00 \uc6d0\uc791\uc9c0\uc2dd\uc73c\ub85c \uc138\uacc4\ucd5c\uac15","ca_name":"\uac8c\uc784,\ub77c\ub178\ubca8,\uc774\uc138\uacc4,\ud310\ud0c0\uc9c0","wr_content":"\ub9c8\uac00\ud3ec\ucf13\uc5d0\uc11c \uaca9\ucc2c \ucf54\uba58\ud2b8 \uc18d\uc18d!! \ud55c\uacc4 \ub355\ud6c4\ub85c \ubab0\uc544\ub123\uc740 \uac8c\uc774\uba38 \ud0c0\ubaa8\uce20\uac00 \ud658\uc0dd\ud55c \uac83\uc740... \uc124\ub9c8 5\ub144 \ud6c4 \ucc98\ud615 \ud655\uc815 \uc545\uc5ed \ud3f0\ucf54\uce20 \ud669\uc790!? \ud558\uc9c0\ub9cc \ucd94\ucc9c \uce90\ub9ad\ud130\uc778 \ub3d9\ubb3c \uadc0 \uba54\uc774\ub4dc \uc9c0\ub098\ub97c \uad6c\ud558\uae30 \uc704\ud574, \ubab0\uc785 \uc9c0\uc2dd\uacfc (\uc880 \ub4a4\ud2c0\ub9b0) \uc6d0\uc791\uc560\ub85c \ubb34\uc30d\ud574\uc838\uc694!! \uc774\ube44\uc624\ub294 \ud615\ub3c4 \ube44\uc5f4\ud55c \uace0\ube14\ub9b0\ub3c4 \uc6d0\uc791 \uc9c0\uc2dd\uc73c\ub85c \uc2f9 \uaca9\ud1f4!","wr_6":"\uc624\ub2e4 \ub3c4\uc6b0\ub9c8","wr_3":"07","wr_datetime":"2022-09-26 22:49:25","wr_2":"2","numone":"1700919"},{"wr_id":"35504","wr_subject":"\ub098\ud0dc\ud55c \uc545\uc695\uadc0\uc871\uc73c\ub85c \uc804\uc0dd\ud55c \ub098, \uc2dc\ub098\ub9ac\uc624\ub97c \ubd80\uc234\ubc84\ub838\ub354\ub2c8 \uaddc\uaca9 \uc678\uc758 \ub9c8\ub825\uc73c\ub85c \ucd5c\ud749\uc774 \ub418\uc5c8\ub2e4","ca_name":"\ub77c\ub178\ubca8,\uc774\uc138\uacc4,\uc804\uc0dd,\ud310\ud0c0\uc9c0","wr_content":"\uc815\ub9d0 \uc88b\uc544\ud558\ub294 \ud559\uc6d0 \uac8c\uc784\uc758 \ub2a5\uc695 \uc545\uc5ed \uadc0\uc871 \ubc14\uc774\uc2a4 \ud32c\uc13c\ud2b8\ub85c \uc804\uc0dd\ud55c \ub098. \uc557, \uc774\ub300\ub85c\ub77c\uba74 \uc8fc\uc778\uacf5\uc5d0\uac8c \uc545\ud589\uc774 \ud3ed\ub85c\ub418\uc5b4 \ubaa8\ub4e0 \uac83\uc744 \uc783\uc740 \ud6c4, \ucd5c\ud6c4\ub294 \ub9c8\uc655\uc758 \ubd80\ud558\uac00 \ub418\uc5b4 \ud30c\uba78 \uc5d4\ub529!? \uadf8\ub807\ub2e4\uba74 \uc555\ub3c4\uc801\uc778 \ud798\uc744 \ubab8\uc5d0 \uc775\ud600 \ud30c\uba78 \ub8e8\ud2b8\ub97c \ud68c\ud53c\ud560 \uc218\ubc16\uc5d0 \uc5c6\ub2e4!! \uc785\ud559 \uc2dc\ud5d8\uae4c\uc9c0 \uc2dc\uac04\uc774 \uc5c6\ub294 \ub098\ub294 S\uae09 \ubaa8\ud5d8\uac00 \ubc00\ud06c \uc544\ube44\ud0c0\uc2a4\ub85c\ubd80\ud130 \uac80\uc220\uacfc \ub9c8\ubc95\uc744 \ubc30\uc6b0\uace0, \ud53c\uac00 \ubc88\uc9c0\ub294 \ub178\ub825\uc758 \ub098\ub0a0\uc744 \uac70\ub4ed\ud55c\ub2e4. \uba87 \ub144 \ud6c4, \uc785\ud559 \uc2dc\ud5d8\uc5d0\uc11c \ubaa8\ub4e0 \uc18d\uc131 \ub9c8\ubc95\uacfc \ucc3d\uc870 \ub9c8\ubc95\uc744 \uc120\ubcf4\uc774\uba74 \ucd94\uc704\uac00 \uba4d\ud574\uc9c0\ub294 \uc0ac\ud0dc\ub85c. \uc5b4\ub77c,\ub098, \ubb54\uac00 \ud574\ubc84\ub838\uc5b4\uc694!? \uc774\uac83\uc740 \uac8c\uc73c\ub974\uace0 \uc545\uc5ed\ubb34\ub3c4\ud55c \uadc0\uc871\uc73c\ub85c \uc804\uc0dd\ud55c \ub0b4\uac00 \ud30c\uba78 \ud50c\ub798\uadf8\ub97c \ubd80\uc218\uae30 \uc704\ud574 \ub178\ub825\uc73c\ub85c \ucd5c\ud749\uc5d0 \uc774\ub974\ub294 \uc774\uc138\uacc4 \ud559\uc6d0 \ud310\ud0c0\uc9c0.","wr_6":"\uc624\ub2e4 \ub3c4\uc6b0\ub9c8","wr_3":"07","wr_datetime":"2026-11-14 19:24:03","wr_2":"4","numone":"1773044"},{"wr_id":"19889","wr_subject":"\uc804\uc0dd \uc601\uc560\ub294 \ubaa8\ud5d8\uac00\ub97c \ubaa9\ud45c\ub85c \ud55c\ub2e4","ca_name":"\uc774\uc138\uacc4 \uc804\uc0dd, \ud310\ud0c0\uc9c0, \uc545\uc5ed \uc601\uc560","wr_content":"\ub208\uc774 \ub0b4\ub9ac\ub358 \uc5b4\ub290 \ub0a0,\ubc31\uc791 \uc601\uc560 \uc140\ub808\ud53c\uc624\ub124 \uadf8\ub791\uc81c\uc6b0\uc2a4(3\uc0b4)\uc740 \ubcf5\uc2ac\ubcf5\uc2ac\ud55c \uc131\uc218 \ub8e8\ub2e4\ub9b4\ud398\ub098\uc640 \uc811\ucd09\ud558\uba74\uc11c 30\ub300 \uc5ec\uc131\uc774\uc5c8\ub358 \uc804\uc0dd\uc758 \uae30\uc5b5\uc744 \ub418\ucc3e\uc558\ub2e4.\ud604\uc7ac \uc788\ub294 \uc138\uacc4\uac00 \uc804\uc0dd\uc5d0 \uc77d\uc740 \uc18c\uc124\uc758 \ub0b4\uc6a9\uacfc \uc720\uc0ac\ud558\uace0 \ub354\uad6c\ub098 \uc790\uc2e0\uc774 \ud30c\uba78\uc5d4\ub529\uc744 \ub9de\uc774\ud558\ub294 \uc545\uc5ed\uc601\uc560\ub77c\ub294 \uc0ac\uc2e4\uacfc \ud568\uaed8\u2015.\u300c\uc808\ub300 \uc2eb\uc5b4, \ub098\ub294 \uc545\uc5ed \ub530\uc708 \ub418\uace0 \uc2f6\uc9c0 \uc54a\uc544.\u300d\ucd5c\uc545\uc758 \uc6b4\uba85\uc73c\ub85c\ubd80\ud130 \ubc97\uc5b4\ub098\uae30 \uc704\ud574 \uc804\uc0dd \uc601\uc560 \uc140\ub808\ub294 \ubaa8\ud5d8\uac00\uac00 \ub418\uc5b4 \uc131\uc218 \ub8e8\uc640 \ud568\uaed8 \uc5ec\ud589\uc744 \ub5a0\ub0a0 \uac83\uc744 \uacb0\uc758\ud558\uc9c0\ub9cc \uc880\ucc98\ub7fc \ub73b\ub300\ub85c \ud480\ub9ac\uc9c0 \uc54a\ub294\ub370?!","wr_6":"\uc624\ub2e4 \ud788\ub85c","wr_3":"03","wr_datetime":"2024-02-27 18:16:52","wr_2":"3","numone":"137708"},{"wr_id":"37756","wr_subject":"\uc81c107\ub9c8\uc218 \uc804\uc120\uc758 \uae30\uc0ac\ub2e8 ~\ud6c4\ud1a0\uc2dc \uc624\ub514\uc138\uc774~","ca_name":"\uc561\uc158,\ud310\ud0c0\uc9c0","wr_content":"\ub0ae\uacfc \ubc24\uc744 \uac00\ub9ac\uc9c0 \uc54a\uace0 \ub9c8\uc218\ub4e4\uc774 \ub04a\uc784\uc5c6\uc774 \ubc00\ub824\ub4dc\ub294 \uac00\ud639\ud55c \ucd5c\uc804\uc120 \u2018107 \uc804\uc120\u2019. \uc774\uacf3\uc744 \ucc45\uc784\uc9c0\ub294 \uc544\ub984\ub2f5\uace0 \uac15\ub825\ud55c \uae30\uc0ac\ub2e8\uc7a5 \u2018\uc288\ubc14\ub9ac\uc5d0\u2019\ub294 \ud640\ub85c \uace0\ub3c5\ud558\uac8c \uc804\uc120\uc744 \uc9c0\ucf1c\uc654\uc2b5\ub2c8\ub2e4","wr_6":"\uc624\ub2e4 \ud1a0\ubaa8\ud788\ud1a0","wr_3":"07","wr_datetime":"2026-10-21 15:06:17","wr_2":"5","numone":"1831466"},{"wr_id":"2675","wr_subject":"\ucf54\ubbf8 \uc591\uc740, \ucee4\ubba4\uc99d\uc774\uc5d0\uc694","ca_name":"\uac1c\uadf8,\ud559\uc6d0,\ub7ec\ube0c\ucf54\ubbf8\ub514,\uc560\ub2c8\ud654","wr_content":"\ubaa8\ub4e0 \uc0ac\ub78c\ub4e4\uc774 \ub4a4\ub3cc\uc544\ubcf4\ub294 \ubbf8\uc18c\ub140 \ucf54\ubbf8\uc591\uc740 \ucee4\ubba4\uc99d\uc774\ub2e4,\uc2ec\uac01\ud55c \uc218\uc900\uc758 \ucee4\ubba4\uc99d\uc774\ub77c \uc0ac\ub78c\ub4e4\uc758 \uacfc\ub3c4\ud55c \uc8fc\ubaa9\uacfc \uad00\uc2ec\uc5d0 \uad73\uc5b4\ubc84\ub9b0\ub2e4.\uadf8\ub7f0 \ucf54\ubbf8 \uc591\uacfc \uce5c\uad6c\uac00 \ub41c \ud0c0\ub2e4\ub178 \uad70. \uc810\ucc28 \ub9c8\uc74c\uc744 \ud130\ub193\uac8c \ub41c \ub450 \uc0ac\ub78c\uc740 \uc5b4\ub5a4 \uc57d\uc18d\uc744 \ud55c\ub2e4.\uc911\ub3c5 \ub420\uc218\ubc16\uc5d0 \uc5c6\ub294 \ucee4\ubba4\uc99d \uc18c\ub140\uc758 \ucf54\ubbf8\ub514\uac00 \uc2dc\uc791\ub41c\ub2e4!!","wr_6":"\uc624\ub2e4 \ud1a0\ubaa8\ud788\ud1a0","wr_3":"02","wr_datetime":"2025-03-29 00:48:39","wr_2":"14","numone":"32860"},{"wr_id":"24965","wr_subject":"\ud76c\ubbf8\ud558\uac8c \ubcf4\uc774\ub294 \uc18c\ub144","ca_name":"\uacf5\ud3ec","wr_content":"\ubbf8\ub824\ud55c \ud654\ud48d\uc73c\ub85c \uc790\uc544\ub0b4\ub294 \uc804\uc728\uc758 \ud638\ub7ec \uc561\uc158! \u3008\ud76c\ubbf8\ud558\uac8c \ubcf4\uc774\ub294 \uc18c\ub144\u3009 1\uad8c  \ube44\ub6a4\uc5b4\uc9c4 \uc131\uaca9\uc758 \uc18c\ub144 \uce74\ud0c0\ub098\uae30 \uc774\uc624\ub9ac\ub294 \uc77c\uc0c1 \uc18d\uc5d0 \uc228\uc5b4 \uc788\ub294 \uc601\uad34(\u9748\u602a)\ub97c \ud1f4\uce58\ud558\ub294 \uc758\uc695 \uc5c6\ub294 \uc601\ub9e4\uc0ac. \uadf8\ub7f0\ub370 \uc808\ub300 \ubcf5\uc885\ud574\uc57c \ud558\ub294 \ub204\ub098\uc758 \uba85\ub839\uc73c\ub85c \uc0ac\ub78c\uc744 \ub3d5\ub294 \uac78 \uc88b\uc544\ud558\uace0 \uc704\ud5d8\uc744 \uac10\uc9c0\ud560 \uc218 \uc788\ub294 \uc18c\ub140, \uc544\uc774\ubca0\uce20 \ub9ac\ucfe0\uc5d0\uac8c \ub4e4\ub7ec\ubd99\uc740 \uc601\uad34\ub97c \uc870\uc0ac\ud558\uac8c \ub41c\ub2e4\u2026. \uadf8\ub9ac\uace0 \uc790\uc2e0\uacfc \ub9ac\ucfe0\uac00 \uac00\uc9c4 \ud2b9\uc774\ud55c \ub2a5\ub825\uc5d0 \ub300\ud574 \ubb34\uc11c\uc6b4 \uc0ac\uc2e4\uc744 \uc54c\ub9ac\ub294\ub370\u2500\u2500?!","wr_6":"\uc624\ub2e4 \ud1a0\ubaa8\ud788\ud1a0","wr_3":"06","wr_datetime":"2023-05-09 11:49:03","wr_2":"2","numone":"288637"},{"wr_id":"34768","wr_subject":"\ub291\ub300\ub0a8\uacfc \ubcbd\uadc0\uc2e0\uca29","ca_name":"\ub7ec\ube0c\ucf54\ubbf8\ub514,\ud310\ud0c0\uc9c0,\ud559\uc6d0","wr_content":"","wr_6":"\uc624\ub2e4\uce74 \ucf04\ud0c0\ub85c","wr_3":"07","wr_datetime":"2026-10-14 15:14:44","wr_2":"4","numone":"1745057"},{"wr_id":"7742","wr_subject":"\uc218\ud559 \uac15\uc0ac\uc5d0\uac8c \ubb38\uc790\ub97c \uc798\ubabb \ubcf4\ub0b4\uc11c \uacb0\ud63c\ud558\uac8c \ub41c \uc0ac\uac74","ca_name":"\ubbf8\uc18c\uce74\uce20","wr_content":"","wr_6":"\uc624\ub2e4 \uc544\uc57c","wr_3":"11","wr_datetime":"2019-03-14 18:30:18","wr_2":"14","numone":"58982"},{"wr_id":"3382","wr_subject":"\uc18c\uc545\ub9c8 \uce74\ud398","ca_name":"\uc21c\uc815","wr_content":"\ud55c \ub208\uc5d0 \ubc18\ud55c \ucd08\uc808\uc815 \ubbf8\ub0a8 \uce58\uce74\ub97c \ucad3\uc544 \uc0ac\ucfe0\ub77c\uac00 \ub2f9\ub3c4\ud55c \uacf3\uc740 \uc6e8\uc774\ud130\uc640 \uc5ec\uc790 \uc190\ub2d8\ubc16\uc5d0 \uc5c6\ub294 \uc218\uc0c1\ud55c \uce74\ud398. \uce58\uce74\uc5d0\uac8c \ub2e4\uac00\uc11c\uace0 \uc2f6\uc5b4\uc11c \ub0a8\uc790\ub77c\uace0 \uac70\uc9d3\ub9d0\uc744 \ud55c \ub4a4, \uc544\ub974\ubc14\uc774\ud2b8\ub97c \uc2dc\uc791\ud55c \uc0ac\ucfe0\ub77c. \ud558\uc9c0\ub9cc, \uce58\uce74\ub294 \ucc9c\uc0ac\uc758 \uc5bc\uad74\uc744 \ud55c \uc18c\uc545\ub9c8\uc600\ub2e4...?! \ub9e4\ubc88 \uc0ac\ucfe0\ub77c\ub294 \ub180\ub9bc \ub2f9\ud558\uace0, \uc9d3\uad82\uc740 \uc7a5\ub09c\uc5d0 \ub2f9\ud558\uae30 \uc77c\uc464! \uadf8\ub798\ub3c4 \uc0ac\ucfe0\ub77c\ub294 \ud3ec\uae30\ud558\uc9c0 \uc54a\uc744 \uac70\uc57c!!","wr_6":"\uc624\ub2e4 \uc544\uc57c","wr_3":"01","wr_datetime":"2020-03-09 06:16:06","wr_2":"14","numone":"18318"},{"wr_id":"23160","wr_subject":"\ubcf4\uc774\uc988 \ud0b9\ub364","ca_name":"\uc21c\uc815","wr_content":"\ud788\uba54\uc57c\uac00 \ud2b9\uae30\uc0dd\uc73c\ub85c \uc804\ud559\uc628 \ud560\ub810\ub8e8\uc57c\ud559\uc6d0\uc740 \uc6d0\ub798\ub294 \ub0a8\ud559\uad50\uc600\ub2e4. \uc8fc\ubcc0\uc5d0 \ub0a8\ud559\uc0dd\ub4e4 \ubfd0\uc774\ub77c \uccab\ub0a0\ubd80\ud130 \uc2e0\ubcc0\uc5d0 \uc704\ud611\uc774. \uc138\uc77c\ub7ec\ubcf5\uc744 \uc785\uc740 \uce78\ub098\uac00 \ub3c4\uc640\uc918\uc11c \ud559\uc0dd\ud68c, \ud1b5\uce6d \ud560\ub810\ub8e8\uc57c\ud68c\uc758 \uc785\ubd80\ub97c \uad8c\uc720\ubc1b\uc740 \ud788\uba54\uc57c. \ud558\uc9c0\ub9cc \ud68c\uc7a5\uc778 \uce74\uc624\uc6b0\ub294 \uc774\uc0c1\ud55c \ub0a8\uc790\ub77c\uc11c, \uc785\ubd80\ub97c \uaebc\ub824\uc9c0\ub294\ub370. \uac8c\ub2e4\uac00 \uc758\uc9c0\ud558\uace0 \uc788\ub358 \uce78\ub098\uae4c\uc9c0 \ub0a8\uc790\uc600\ub2e8 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub418\uace0\u2026!","wr_6":"\uc624\ub2e4 \uc544\uc57c","wr_3":"05","wr_datetime":"2020-03-10 02:06:57","wr_2":"14","numone":"218084"},{"wr_id":"23161","wr_subject":"\ucc9c\uc5f0 \ubc8c\uafc0 \uae30\uc219\uc0ac","ca_name":"\uc21c\uc815","wr_content":"\ub124\ub124\uc640 \ud788\uce74\ub8e8\uac00 \ub4e4\uc5b4\uac04 \ud559\uad50\ub294 \uc804\uc6d0 \uae30\uc219\uc0ac\uc81c. \uac70\uae30\ub2e4 \ud558\ub098\ubbf8\uce20 \uae30\uc220\uc0ac\ub294 \ub0a8\ub140\uacf5\uc6a9\uae30\uc219\uc0ac\u2026?!","wr_6":"\uc624\ub2e4 \uc544\uc57c","wr_3":"05","wr_datetime":"2020-03-10 02:06:57","wr_2":"14","numone":"218062"},{"wr_id":"23162","wr_subject":"\uc0ac\ub791\ud55c\ub2e4\uace0 \ub9d0\ud574\ub3c4 \uc88b\uc544","ca_name":"\uc21c\uc815","wr_content":"\uc57d\uc18c \ub808\ucf54\ub4dc\ud68c\uc0ac\uc5d0 \uadfc\ubb34\ud558\ub294 \uc624\uc624\uc81c\ud0a4 \ub098\uce20\ubbf8\ub294 \ubd80\uc0c1\uc744 \uc774\uc720\ub85c \uc740\ud1f4\ud55c \uc804 \uc721\uc0c1\uc120\uc218.\uadf8\ub140\ub294 \ub2a5\ub825 \uc788\ub294 \uc120\ubc30 \uce74\ubbf8\uc2dc\ub85c\ub97c \ub3d9\uacbd\ud558\uc9c0\ub9cc,\uc74c\uc545\uc5c5\uacc4\uac00 \uc790\uc2e0\uc5d0\uac8c \ub9de\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc0dd\uac01\uc5d0 \uace0\ubbfc\ud55c\ub2e4.\uadf8\ub7ec\ub358 \uc5b4\ub290 \ub0a0,\uce74\ubbf8\uc2dc\ub85c\uac00 \uadf8\ub140\uc5d0\uac8c \uc544\ud2f0\uc2a4\ud2b8 \ud0c0\ud0a4\uc758 \ub2f4\ub2f9\uc744 \ub9e1\uae30\uae30\ub85c \uacb0\uc815.\ud558\uc9c0\ub9cc \uadf8\ub294 \uc880\ucc98\ub7fc \uace1\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294 \ubb38\uc81c\uc544\uc778\ub370?!\ub9c8\uc74c\uc744 \uc6b8\ub9ac\ub294 \ub7ec\ube0c\uc2a4\ud1a0\ub9ac \uc81c1\ud0c4!","wr_6":"\uc624\ub2e4 \uc544\uc57c","wr_3":"05","wr_datetime":"2020-03-10 02:06:57","wr_2":"14","numone":"218179"},{"wr_id":"33836","wr_subject":"\uc548\uae34 \ub4a4 \uae68\ub2eb\ub294 \uc0ac\ub791\ub3c4 \uc788\ub2e4","ca_name":"\uc21c\uc815","wr_content":"\uc77c\ub2e8 \uba3c\uc800 \uc548\uc544 \ubcf4\uace0 \ub098\uc11c \uc0ac\ub791\ud574\ub3c4 \ub420\uae4c?\uc624\ub7ab\ub3d9\uc548 \uc0ac\uadc0\uc5c8\ub358 \ub0a8\uc790 \uce5c\uad6c\ub85c\ubd80\ud130 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc774\ubcc4 \ud1b5\ubcf4.\uadf8\ub9ac\uace0 \uc624\ub7ab\ub3d9\uc548 \uafc8\uafd4\uc654\ub358 \ubcf8\uc0ac \uadfc\ubb34\uac00 \uc2dc\uc791\ub41c \ubbf8\ub098\ubbf8\ub178 \ubbf8\ucfe0.\ub9c8\uc74c\uc744 \ub2e4\uc7a1\uace0 \uc0c8\ub86d\uac8c \ucd9c\ubc1c\ud558\ub824\ub358 \uadf8\ub140 \uc55e\uc5d0\uac74\ubc29\uc9c4 \ubd80\ud558 \uc9c1\uc6d0 \uc2a4\uc624\uc6b0 \ud0c0\uc2a4\ucfe0\uac00 \ub098\ud0c0\ub09c\ub2e4!","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"07","wr_datetime":"2022-08-17 20:26:48","wr_2":"4","numone":"1698527"},{"wr_id":"21347","wr_subject":"Secret Shelter","ca_name":"\uc21c\uc815, 17","wr_content":"\uc0ac\ub791\ud558\ub294 \ud30c\ud30c\uc640 \uc601\uc6d0\ud788 \ud568\uaed8 \uc0b4\uac70\ub77c\uace0 \uc0dd\uac01\ud588\ub358 \ub098\uc758 \uafc8\uc774 \uadf8\uc758 \uc560\uc778\uc73c\ub85c \uc778\ud574 \uae68\uc84c\ubc84\ub838\ub2e4!? `\uc774\ub7f4\uc904 \uc54c\uc558\uc73c\uba74 \uc5b5\uc9c0\ub85c \uc62c\ub77c \ud0c0\ub294 \uac70\uc600\ub294\ub370~!` \uc560\uc778\uacfc \ud30c\ud30c\ub97c \uac08\ub77c\ub193\uae30 \uc704\ud574 \uac00\ucd9c\ud55c \ub098,\uadf8\ub9ac\uace0 \ub098\ub97c \uac70\ub46c \uc900 4\uba85\uc758 \ubbf8\uc18c\ub144. \uc704\ud5d8\ud55c \ub9e4\ub825\uc744 \uac00\uc9c4 \uadf8\ub4e4\uc5d0\uac8c \ub450\uadfc\uac70\ub9ac\uc9c0\ub9cc \ub098\ub294 \uc624\ub85c\uc9c0 \ud30c\ud30c \ub7ec\ube0c!! \uc774\uacf3\uc744 \ud53c\ub09c\ucc98 \uc0bc\uc544 \ubc18\ub4dc\uc2dc \ud30c\ud30c\uc640 \uc560\uc778\uc744 \uac08\ub77c\uc11c\uac8c \ub9cc\ub4e4\uaca0\uc5b4!","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181142"},{"wr_id":"21348","wr_subject":"\ub098\uc5d0\uac8c \uc695\uc815 \ud574\uc918","ca_name":"17, \uc21c\uc815","wr_content":"\uc5b4\ub978\uc2a4\ub7ec\uc6b4 \ubaa8\uc2b5\uacfc \uae30\uc13c \uc131\uaca9\uc73c\ub85c \uc720\uba85\ud55c \ub098\ub098\uc624 \uc720\uce74\ub9ac.\uba87 \ubc88\uc758 \uc2e4\ud328 \ub05d\uc5d0 \uadf8\ub140\uac00 \ucc3e\uc544\ub0b8 \uc815\ub2f5\uc740 \ud559\uad50 \ud6c4\ubc30\uc778 \ucf04\ud1a0\uc600\ub2e4.\ud558\uc9c0\ub9cc \ub098\ub098\uc624\ub294 \ucf04\ud1a0\uc758 \uc804 \uc5ec\uc790 \uce5c\uad6c\ub77c\ub294,\ubcf4\uc774\uc9c0 \uc54a\ub294 \uc0c1\ub300\ub97c \ub118\uc5b4\uc11c\uc57c \ud560 \ucc98\uc9c0\uc5d0 \ub193\uc5ec \uc788\uc5c8\ub294\ub370\u2026.\ubc29\ud669\ud558\uace0 \uc5c7\uac08\ub9ac\ub294 \ub450 \uc0ac\ub78c\uc740, \uadf8\ub4e4\uc774 \uc815\ub9d0\ub85c \uc6d0\ud558\ub294 \uac83\uc744 \ucc3e\uc544\ub0bc \uc218 \uc788\uc744\uae4c?","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181137"},{"wr_id":"21349","wr_subject":"90\uc77c \uacc4\uc57d \ub0a8\uce5c","ca_name":"17, \uc21c\uc815","wr_content":"`90\uc77c \ub3d9\uc548 \uc644\ubcbd\ud55c \ub0a8\uc790\uce5c\uad6c\uac00 \ub418\uc5b4 \ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\uba3c\uc800 \ub2e4\uac00\uc628 \uac74\u2026 \uc120\ubc30\uc796\uc544\uc694?`3\uac1c\uc6d4 \ud6c4, \ud68c\uc0ac\ub97c \uadf8\ub9cc\ub450\uace0 \uac00\uc5c5\uc744 \uc787\uac8c \ub418\uc5b4\ubc84\ub9b0 \ub178\uae30.\uc774\ub97c \uacc4\uae30\ub85c \uadf8\ub140\ub294 \ub9c8\uc74c\uc5d0 \ub450\uace0 \uc788\ub358 \ud6c4\ubc30 \uc9c1\uc6d0 \uc624\uc0ac\uce74\uc5d0\uac8c3\uac1c\uc6d4 \ud55c\uc815 \uc5f0\uc778\uc774 \ub418\uc5b4\ub2ec\ub77c\uace0 \ubd80\ud0c1\ud558\uac8c \ub41c\ub2e4.\uac70\uc808 \ub2f9\ud558\ub9ac\ub77c\uace0 \uc0dd\uac01\ud588\uc9c0\ub9cc, \ud55c \ubc88\uc5d0 \uadf8\ub140\uc758 \uace0\ubc31\uc744 \ubc1b\uc544\ub4e4\uc778 \uc624\uc0ac\uce74\ub294\uae30\uac04 \ud55c\uc815 \uc5f0\uc778 \uccab\ub0a0\ubd80\ud130 \uadf8\ub140\ub97c \uc0ac\uc815\uc5c6\uc774 \ud718\uc813\uae30 \uc2dc\uc791\ud558\ub294\ub370?!","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181130"},{"wr_id":"21355","wr_subject":"\uce5c\uad6c\uc778\ub370 \ud574\ub3c4 \ub420\uae4c","ca_name":"\uc21c\uc815, 17","wr_content":"`\uacbd\ud5d8\u2026 \ud574\ubcf4\uace0 \uc2f6\uc9c0 \uc54a\uc544? \ub09c \ud558\uace0 \uc2f6\uc5b4.` \ud56d\uc0c1 \uc608\uc05c \uc5ec\uc790\ub4e4\ub85c \ub458\ub7ec\uc2f8\uc5ec \uc788\ub294 \uc18c\uafc9\uce5c\uad6c \uc720\uc6b0. \ub204\uad70\uac00\uc640 \uc0ac\uadc4\ub2e4\ub294 \uc18c\ubb38\uc774 \ub4e4\ub824\uc640\ub3c4 \uc720\uc774\uc640 \uc720\uc6b0\ub294 \uc774 \ube44\ubc00\ub9cc \uc9c0\ucf1c\uc9c0\uba74 \ub204\uad6c\ub3c4 \uc0c1\ucc98\ubc1b\uc9c0 \uc54a\ub294 \uad00\uacc4\ub97c \uacc4\uc18d\ud558\uace0 \uc788\uc5c8\ub2e4. \uc720\uc6b0\ub294 \uc5ec\uc790 \uce5c\uad6c\uac00 \uc0dd\uaca8\ub3c4 \uc774 \uad00\uacc4\ub97c \uc774\uc5b4\uac08 \uac70\ub77c\uace0 \ud558\uc9c0\ub9cc, \uadf8\uac00 \uc815\ub9d0 \uc88b\uc544\ud558\ub294 \uc0ac\ub78c\uc774 \uc0dd\uacbc\uc744 \ub54c\ub97c \uacc4\uc18d \uc0c1\uc0c1\ud558\ub294 \uc720\uc774\u2026. \uadf8\ub7ec\ub358 \uc5b4\ub290 \ub0a0, \uac70\ub9ac\uc5d0\uc11c \uc6b0\uc5f0\ud788 \uc720\uc6b0\uc640 \uc5ec\uc790 \uce5c\uad6c\ub97c \ub9cc\ub09c \ub4a4, \ub9c8\uc74c\uc774 \ubcf5\uc7a1\ud574\uc9c4 \uc720\uc774\ub294 \uadf8\uc758 \uc5f0\ub77d\uc744 \ud53c\ud558\uae30 \uc2dc\uc791\ud558\ub294\ub370\u2026.","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181212"},{"wr_id":"21356","wr_subject":"\uce5c\uad6c\uc778\ub370 \ub354 \ud574\ub3c4 \ub420\uae4c","ca_name":"17, \uc21c\uc815","wr_content":"\uc88b\uc544\ud558\ub294 \uc0ac\ub78c\uc740 \ub2e8 \ud55c \uba85 \ubfd0. \ud558\uc9c0\ub9cc `\uc5f0\uc778`\uc740 \uc544\ub2c8\ub2e4\u2026?\ub204\uad6c\ubcf4\ub2e4\ub3c4 \uc11c\ub85c\ub97c \uc0ac\ub791\ud558\uc9c0\ub9cc \uc5f0\uc778\uc740 \uc544\ub2cc \ub450 \uc0ac\ub78c\uc758 \ube44\ubc00\uc2a4\ub7ec\uc6b4 \uad00\uacc4, \uadf8 \ub450 \ubc88\uc9f8 \uc774\uc57c\uae30!\uc720\uc774\uc640 \uc720\uc6b0, \uc18c\uafc9\uce5c\uad6c\uc778 \ub450 \uc0ac\ub78c\uc740 \uc138\uc0c1\uc5d0\uc11c \uc11c\ub85c\ub97c \ub204\uad6c\ubcf4\ub2e4\ub3c4 \uc0ac\ub791\ud558\ub294 \uc0ac\uc774.\ud55c\ubc14\ud0d5 \uc18c\ub3d9 \ub05d\uc5d0, \uc720\uc6b0\ub294 \uc804 \uc5ec\uc790\uce5c\uad6c\uc5d0\uac8c `\uc5ec\uc790\uce5c\uad6c\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\uaca0\ub2e4`\ub294 \uc57d\uc18d\uc744 \ud55c\ub2e4.\uc720\uc774\uc640 \ub2e4\uc2dc \ud2b9\ubcc4\ud55c \uad00\uacc4\ub85c \ub3cc\uc544\uc62c \uc218 \uc788\uc5b4 \ub9cc\uc871\uc2a4\ub7ec\uc6e0\ub358 \uc720\uc6b0\uc600\uc9c0\ub9cc\u2026.\uac11\uc791\uc2a4\ub7ec\uc6b4 \uc720\uc774\uc758 \ubd80\ubaa8\ub2d8\uc758 \ub3cc\ubc1c \uc120\uc5b8\uc73c\ub85c \ub450 \uc0ac\ub78c\uc758 \uad00\uacc4\uc5d0 \ud070 \ubcc0\ud654\uac00 \uc77c\uc5b4\ub098\uace0 \ub9c8\ub294\ub370\u2026?","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181135"},{"wr_id":"21357","wr_subject":"\ucc98\uc74c\uc774\uba74 \uc548 \ub418\ub098\uc694","ca_name":"\uc21c\uc815, 17","wr_content":"29\uc0b4\uc774 \ub420 \ub54c\uae4c\uc9c0 \uc5f0\uc560 \uacbd\ud5d8 \uc81c\ub85c, \ub530\ub77c\uc11c \ub2f9\uc5f0\ud788 \ub0a8\uc790 \uacbd\ud5d8\ub3c4 \uc81c\ub85c\uc778 \uc544\uc774\ucf54. \uadf8\ub140\ub294 \uc9c0\uae08 \ubbff\uc744 \uc218 \uc5c6\uac8c\ub3c4 9\uc0b4 \uc5f0\ud558\uc778 \ub300\ud559\uc0dd \ub9ac\ucfe0\uc640 \uc0ac\uadc0\ub294 \uc911\uc774\ub2e4. \ud3b8\uc758\uc810\uc5d0\uc11c \uc544\ub974\ubc14\uc774\ud2b8\ub97c \ud558\ub358 \ub9ac\ucfe0\uac00 \uc57c\uadfc \ud798\ub0b4\ub77c\uba70 \uba38\ub9ac\ub97c \uc4f0\ub2e4\ub4ec\uc5b4 \uc8fc\uc5c8\uc744 \ub54c, \uc0ac\ub791\uc744 \ubab0\ub790\ub358 \uc544\uc774\ucf54\uc758 \ub9c8\uc74c\uc740 \uc644\uc804\ud788 \uadf8\uc5d0\uac8c \ube60\uc9c0\uace0 \ub9d0\uc558\ub2e4. \uc0ac\uadc0\ub294 \uc2dc\uac04\uc774 \uae38\uc5b4\uc9c8\uc218\ub85d \ub9ac\ucfe0\ub294 \uadf8\ub140\uc758 \ubab8\uc744 \uc6d0\ud558\uc9c0\ub9cc, \ucc28\ub9c8 \ucc98\uc74c\uc774\ub77c\uace0 \ub9d0\ud560 \uc218 \uc5c6\uc5c8\ub358 \uc544\uc774\ucf54. \uba87 \ubc88\uc774\ub098 \ub9ac\ucfe0\ub97c \uac70\uc808\ud558\ub358 \uc5b4\ub290 \ub0a0, \uc544\uc774\ucf54\ub294 \uadf8\uc5d0\uac8c \uac78\ub824\uc628 \uc804\ud654\uc5d0\uc11c \uc5ec\uc790\uc758 \ubaa9\uc18c\ub9ac\ub97c \ub4e3\uac8c \ub41c\ub2e4. `\ub9ac\ucfe0, \ucc45\uc784\uc9c0\uaca0\ub2e4\uace0 \ud588\uc9c0? \ub354 \ub2a6\uc5b4\uc9c0\uba74 \uc815\ub9d0 \ub5c4 \uc218 \uc5c6\uac8c \ub418\ub2c8\uae4c\u2026 \ube68\ub9ac \ub3c8\uc744 \uc900\ube44\ud574 \uc918!` 3\uac1c\uc6d4 \uc804, \uac11\uc790\uae30 \uace0\ubc31\ud588\ub358 \uac74 \ub3c8\uc774 \ud544\uc694\ud574\uc11c \uadf8\ub7f0 \uac70\uc600\uc5b4\u2026?","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181237"},{"wr_id":"21358","wr_subject":"\uc808\ub300\uc0c1\uc0ac","ca_name":"\uc21c\uc815, 17","wr_content":"\uc57d\ud55c \ub0a8\uc790 \ub530\uc704\ub294 \ub531 \uc9c8\uc0c9\uc774\uc57c. \ube44\ucc38\ud55c \uae30\ubd84\uc774 \ub4e4\uac8c \ud558\ub2c8\uae4c.\ud558\uc9c0\ub9cc \uc138\uc0c1\uc5d0\ub294 \uc57d\ud55c \ub0a8\uc790\uac00 \ub108\ubb34 \ub9ce\uc544.\u2026\uc0c8 \uc0c1\uc0ac\uc778 \uc774 \uc0ac\ub78c\uc740 \uc9c0\uae08\uae4c\uc9c0\uc640\ub294 \ub2e4\ub97c \uac70\uc57c\u2026!!\ubaa8\ub450\uac00 \ub530\ub974\uace0 \uc2f6\uc740 \ub0a8\uc790\u2661 \uc0ac\ub791\ub3c4 \uc77c\ub3c4 \ub3d9\uae30\ubd80\uc5ec UP\u2191\ub418\ub294\ucd5c\uc0c1\uc758 \uc624\ud53c\uc2a4 \ub7ec\ube0c \uc2dc\ub9ac\uc988!","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181196"},{"wr_id":"21359","wr_subject":"\uc5d0\ub85c\ud2f1 \ud30c\ub77c\ub2e4\uc774\uc2a4","ca_name":"17, \uc21c\uc815","wr_content":"\uaf43\ubbf8\ub0a8 5\uba85\uc774 \uc77c\ud558\uace0 \uc788\ub294 \ubbf8\uc6a9\uc2e4\uc5d0\uc11c \uc544\ub974\ubc14\uc774\ud2b8\ub97c \ud558\uac8c \ub41c \uce58\ud788\ub85c.\uaf43\ubbf8\ub0a8\uc744 \uc2eb\uc5b4\ud558\ub294 \ub0b4\uac00, \ucfe8\ud558\uace0 \ubb34\ub69d\ub69d\ud558\uc9c0\ub9cc\uc77c\uc5d0 \ub300\ud55c \uc5f4\uc815\uc740 \ub728\uac70\uc6b4 \ud788\ub85c\ud1a0\uc758 \ub9e8\uc5bc\uad74\uc744 \ubcf4\uace0\u2026 \uc124\ub9c8 \uc88b\uc544\ud558\uac8c \ub420 \uc904\uc774\uc57c!!\uc804\uacf5\uc744 \uc0b4\ub824 \uc601\uc591 \uac00\ub4dd\ud55c \uc694\ub9ac\ub97c \ub9cc\ub4e4\uc5b4\uc624\ub2c8 5\uba85 \ubaa8\ub450\uc758 \uad6c\uc560\uac00 \uc774\uc5b4\uc9c0\uace0,\uc9c4\uc2ec\uc73c\ub85c \uace0\ubbfc\ud588\uc9c0\ub9cc \ub204\uac00 \uba3c\uc800 \ud568\ub77d\uc2dc\ud0a4\ub294\uc9c0 \uac8c\uc784\uc744 \ud588\ub358 \uac83\ubfd0\uc774\uc5c8\ub2e4\ub294 \ub9d0\uc5d0\uc0c1\ucc98\ubc1b\uc740 \uce58\ud788\ub85c\ub97c \ud788\ub85c\ud1a0\uac00 \uc704\ub85c\ud574\uc8fc\ub294\ub370\u2026\u2026.","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181217"},{"wr_id":"21360","wr_subject":"\uc131\uc778 \uc5f0\uc560\ubc31\uc11c - \ucc9c\uad6d\uc758 \uba54\uc138\uc9c0","ca_name":"\uc21c\uc815, 17","wr_content":"\uc9c0\ub09c\uc5ec\ub984 \ub9cc\ub0ac\ub358 \ucf00\uc774\ub97c \uc78a\uc9c0 \ubabb\ud558\uace0 \uc788\ub358 \uc911 \uc6b0\uc5f0\ud788 \uc624\ud1a0\ubc14\uc774 \uc18c\ub9ac\uc5d0 \ub04c\ub824 \ub9cc\ub098\uac8c \ub41c \ud314\uc5d0 \ubb38\uc2e0\uc774 \uc0c8\uaca8\uc9c4 \ub0a8\uc790, \ubb54\uc9c0 \uc54c \uc218 \uc5c6\ub294 \ub450\uadfc\uac70\ub9bc\uc774 \uc788\uc5c8\uc9c0\ub9cc \uc7a0\uae50 \uc2a4\uccd0 \uac08 \uc904 \uc54c\uc558\ub358 \uadf8\uac00 \uc544\ubc84\uc9c0\uac00 \uc6b4\uc601\ud558\ub294 \uac00\uac8c\uc5d0\uc11c \ub2f9\ubd84\uac04 \uc6b0\uc5f0\ucc2e\uac8c \uc77c\ud558\uac8c \ub418\uace0 \uadf8\ud1a0\ub85d \uae30\ub2e4\ub9ac\uace0 \ubb38\uc790\ub97c \ubcf4\ub0b4\ub358 `\ucf00\uc774`\uac00 \uc624\ud1a0\ubc14\uc774\uc0ac\uace0\ub85c \uc8fd\uc5c8\ub2e4\ub294 \uc18c\ub9b4 \ub4e3\uace0 \ucda9\uaca9\uc5d0 \ud729\uc2f8\uc774\ub294\ub370...","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181186"},{"wr_id":"21361","wr_subject":"\uc0ac\ub791\uc774\uc57c","ca_name":"\uc21c\uc815, 17","wr_content":"\uace0\uc544\uc6d0\uc5d0\uc11c \uc704\ud0c1\uac00\uc815\uc5d0 \ub4e4\uc5b4\uc628 \uc138\ub77c\ub294 \uadf8\uacf3\uc5d0\uc11c \uc138 \uba85\uc758 \uc655\uc790\ub2d8\ub4e4\uc744 \ub9cc\ub098\uac8c \ub41c\ub2e4.\uc704\ud0c1\uac00\uc815\uc758 \uc0bc \ud615\uc81c\ub294 \uac01\uc790 \uac1c\uc131 \uc788\ub294 \uaf43\ubbf8\ub0a8\ub4e4\uc774\uc9c0\ub9cc \ud558\ub098\uac19\uc774 \uc131\uaca9\uc740 \uaf5d!\uadf8\ub0a0\ubd80\ud130 \uc138\ub77c\uc758 \uace0\ub2ec\ud508 \ud558\ub140 \uc778\uc0dd\uc774 \uc2dc\uc791\ub418\ub294\ub370\u2026.\uc81c\uba4b\ub300\ub85c \uc655\uc790\ub2d8\ub4e4\uacfc \uadc0\uc5ec\uc6b4 \uc21c\uc9c4\ub140 \uc138\ub77c\uc758 \ub7ec\ube0c\uc2a4\ud1a0\ub9ac.\uacfc\uc5f0 \uc0ac\ub791\uc758 \uc791\ub300\uae30\ub294 \uc5b4\ub290 \ucabd\uc73c\ub85c \ud5a5\ud558\uac8c \ub420\uae4c?","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"11","numone":"181181"},{"wr_id":"21362","wr_subject":"\uc0ac\ub791\uc758 \uacbd\uacc4\uc120 \uce68\ub300\uc5d0\uc11c \uce5c\uad6c\ub294 \ub0a8\uc790\uac00 \ub418\uc5c8\ub2e4","ca_name":"17, \uc21c\uc815","wr_content":"\u300c\uc637\uc740 \ub0a8\uc790\uac00 \ubc97\uae30\ub294 \uac70\uc57c\u300d\uce68\ub300\uc5d0 \ub204\uc6cc \ucc98\uc74c \ubcf4\ub294 `\ub0a8\uc790`\uc758 \uc5bc\uad74\uc744 \ud55c \uce5c\uad6c\uc758 \ubaa8\uc2b5\u2026.\uc911\uacac \ucd9c\ud310\uc0ac\uc5d0\uc11c \ub099\uc624\ub41c \uc7a1\uc9c0 \ud3b8\uc9d1\uc7a5\uc774 \ub41c \ud638\uc2dc\ub178 \uc2dc\uc988\ucfe0.\uadf8\ub140\uc640 \uace0\ub4f1\ud559\uad50 \uc2dc\uc808\ubd80\ud130 \ub9cc\ub098 \uc9c0\uae08\uc740 \ud55c \ub2ec\uc5d0 \ud55c \ubc88\uc529 \uc220\uc744 \ub9c8\uc2dc\ub294 \uc0ac\uc774\uac00 \ub41c \uc544\ub9c8\ubbf8\uc57c\ub294 \ub300\uae30\uc5c5 \uc2e0\ubb38\uc0ac\uc758 \uc720\ub2a5\ud55c \uc0ac\uac74 \uae30\uc790\ub2e4.13\ub144 \uc804, \uc544\ub9c8\ubbf8\uc57c\ub85c\ubd80\ud130 \u300c\ub10c \uc18c\uc911\ud55c \uce5c\uad6c\uc57c\u300d\ub77c\ub294 \ub9d0\uc744 \ub4e4\uc740 \uc774\ud6c4\ub85c \uc88b\uc544\ud558\ub294 \uac10\uc815\uc744 \uacc4\uc18d \ubd09\uc778\ud574\uc628 \ud638\uc2dc\ub178.\ud558\uc9c0\ub9cc \uc11c\ub978 \uc0b4\uc774 \ub418\uace0 \uc5f0\uc560\ub3c4 \uc77c\ub3c4 \ub9c8\uc74c\ucc98\ub7fc \ub418\uc9c0 \uc54a\ub294 \ub0a0\ub4e4\uc5d0 \ucd08\uc870\ud574\uc9c0\ub294\ub370\u2026.\uadf8\ub7ec\ub358 \uc5b4\ub290 \ub0a0 \ud3c9\uc18c\uc5d0\ub294 \ucfe8\ud558\uace0 \ucc28\ubd84\ud558\ub358 \uc544\ub9c8\ubbf8\uc57c\uc758 \uc0c1\ud0dc\uac00 \uc774\uc0c1\ud558\ub2e4\ub294 \uac78 \uae68\ub2ec\uc740 \ud638\uc2dc\ub178.\uac11\uc791\uc2a4\ub7fd\uac8c \uc544\ub9c8\ubbf8\uc57c\uc5d0\uac8c \uc190\uc744 \uc7a1\ud78c \uadf8 \uc21c\uac04\u2026\ub354\ub294 \u300e\uce5c\uad6c\u300f\ub85c \uc788\uc744 \uc218 \uc5c6\uac8c \ub418\uc5c8\ub2e4.\uc120\uc744 \ub118\uc5c8\uc744 \ub54c, \uc774 \uad00\uacc4\ub294 \ubb34\ub108\uc9c0\uac8c \ub420\uae4c\u2026?","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181264"},{"wr_id":"21363","wr_subject":"\ubbf8\uc6b4 \ub0a8\uc790","ca_name":"\uc21c\uc815, 17","wr_content":"\uad6d\ubbfc \uc544\uc774\ub3cc\uc778 \uadf8\ub294 \uc5b8\ub2c8\ub97c \ubc84\ub9b0 \ub098\uc05c \ub0a8\uc790.\ud3ab\uc20d \uc544\ub974\ubc14\uc774\ud2b8\ub97c \ud558\ub358 \uc911 \uc6b0\uc5f0\ud788 \ub9cc\ub098\uac8c \ub41c \uadf8, \uc774\ubc88\uc5d0\ub294 \ub0b4\uac00 \ub2f9\uc2e0\uc744 \uac00\uc9c0\uace0 \ub180\uc544 \uc8fc\uaca0\uc5b4\u2026!!\ud558\uc9c0\ub9cc \uc4f8\uc4f8\ud574 \ubcf4\uc774\ub294 \uadf8 \ub0a8\uc790\uc758 \ub208\ube5b\uc744 \ubcf4\uac8c \ub41c \uc21c\uac04, \uc5b4\uc9f8\uc11c \uc774\ub807\uac8c \uac00\uc2b4\uc774 \ub6f0\ub294 \uac78\uae4c\u2026?\ub108\ubb34\ub098\ub3c4 \ubbf8\uc6b4 \ub0a8\uc790\uc778\ub370\u2026.","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181235"},{"wr_id":"21364","wr_subject":"\ub354\ub7fd\ud600\uc9c4 \ucc9c\uc0ac-\uad50\ubcf5 \uc18d\uc758 \ube44\ubc00-","ca_name":"\uc21c\uc815","wr_content":"\ud559\uae30\uac00 \ub2e4 \ub05d\ub098\uae30\ub3c4 \uc804\uc5d0 \uac11\uc790\uae30 \ub3c4\uc2dc\uc5d0\uc11c \uc804\ud559\uc744 \uc628 \ub178\ub178\uce74\uc5d0\uac90 \ube44\ubc00\uc774 \ud558\ub098 \uc788\uc5c8\ub2e4.\uc608\uc804 \ud559\uad50\uc5d0\uc11c \u300c\ucc9c\uc0ac\u300d\ub77c \ubd88\ub838\ub358 \uadf8\ub140\ub294 \uc5b4\ub290 \ub0a0 \ubc29\uacfc \ud6c4 \uad50\uc2e4\uc5d0\uc11c \ub2f4\uc784 \uc120\uc0dd\ub2d8\uc5d0\uac8c \uac15\uc81c\ub85c \ubab9\uc4f8 \uc9d3\uc744\u2026.\uadf8 \ube44\ubc00\uc774 \uc54c\ub824\uc9c0\ub294 \uac8c \ub450\ub824\uc6cc \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \uc2dc\uace8 \uc12c\ub9c8\uc744\ub85c \uc774\uc0ac\ub97c \uc654\uc9c0\ub9cc`\ub108\ub791 \uc5b4\ub514\uc11c \ub9cc\ub09c \uc801 \uc788\ub294 \uac83 \uac19\uc544`\ub77c\uba70 \uc798\uc0dd\uae34 \ub0a8\ud559\uc0dd \uc0ac\uc5d0\ud1a0\uac00 \ub178\ub178\uce74\uc5d0\uac8c \uc560\uc815 \uacf5\uc138\ub97c \ud3bc\uce58\uba70 \ub2e4\uac00\uc628\ub2e4.\ubb38\uc81c\uc544\ub85c \uc720\uba85\ud55c \uc0ac\uc5d0\ud1a0\uc758 \uac10\ucdb0\uc9c4 \uc21c\uc218\ud568\uacfc \uc0c1\ub0e5\ud568\uc744 \uc54c\uac8c \ub41c \ub178\ub178\uce74\ub294 \ub9c8\uc74c\uc18d\uc5d0\uc11c \ub728\uac70\uc6b4 \ubb34\uc5b8\uac00\uac00 \uc6c0\uc9c1\uc774\uae30 \uc2dc\uc791\ud55c\ub2e4.\uadf8\ub7ec\ub358 \uc5b4\ub290 \ub0a0, \uc12c\uc758 \uc720\uba85\ud55c \uc2e0\uc0ac\uc758 \ud6c4\uacc4\uc790\uc778 \ud558\ub8e8\uc57c\uac00 \ub178\ub178\uce74\uc5d0\uac8c \ud638\uac10\uc744 \ub290\ub07c\uace0 \uc811\uadfc.\uadf8\ub7ec\uc790 \ud558\ub8e8\uc57c\ub97c \uc88b\uc544\ud558\ub294 \uc18c\uafc9\uce5c\uad6c \uce74\ub9b0\uc740 \uc9c8\ud22c\uc2ec\uc5d0 \ubd88\ud0c0\uc624\ub974\uace0\u2026.\ub9c8\uc74c\uc18d\uc5d0 \uc0ac\ub791\uacfc \uc5b4\ub460\uc744 \uc548\uace0 \uc0ac\ub294 \uace0\ub4f1\ud559\uc0dd\ub4e4\uc758 \uccad\ucd98 \uad70\uc0c1\uadf9 \uac1c\ub9c9!","wr_6":"\uc624\ub2e4 \ubbf8\uce20\ud0a4","wr_3":"04","wr_datetime":"2019-11-11 03:28:55","wr_2":"14","numone":"181208"}],"counts":43}